# Microsoft Entra ID app registration (client-credential flow, Application permissions).
# The server reads the process environment: pass these through your MCP host's "env" block,
# or export them in the shell that starts the server. Never commit real values.
DEFENDER_TENANT_ID=your-tenant-id
DEFENDER_CLIENT_ID=your-client-id
DEFENDER_CLIENT_SECRET=your-client-secret

# Response actions (device isolation, quarantine, live response, indicator writes, ...)
# are DISABLED by default. Set to exactly "true" to enable them for this deployment.
# DEFENDER_MCP_ALLOW_ACTIONS=true

# What this tenant is entitled to, for the sources a licensing tier gates and no query can settle.
# Comma-separated entitlement ids. It speaks for each family it names an id of: there, an id
# left out is stated to be absent; a family it names nothing of stays undeclared. An empty value
# states the tenant has none. Leave it unset to state nothing: the probe then reports those sources
# as "undeclared" rather than guessing, which is a visibility gap and not an absence. An unknown id
# stops the server at startup.
# Known ids, by family:
#   endpoint_p2 (Microsoft Defender for Endpoint Plan 2, however it is bought: it writes the device
#   event tables and attack disruption's table), endpoint_p1 (no Plan 2: Plan 1, Defender for
#   Business, or no endpoint plan);
#   office365_p2 (Microsoft Defender for Office 365 Plan 2: it writes the email tables),
#   office365_p1 (no Plan 2).
# A Microsoft 365 Business Premium tenant: DEFENDER_MCP_ENTITLEMENTS=endpoint_p1,office365_p1
# DEFENDER_MCP_ENTITLEMENTS=endpoint_p2,office365_p2
