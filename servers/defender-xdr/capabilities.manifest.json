        "kind": "write",
        "permissions": [
          "SecurityIncident.ReadWrite.All"
        ],
        "requires_all": [
          "api:graph.incidents",
          "role:graph/SecurityIncident.ReadWrite.All"
        ],
        "requires_any": [],
        "notes": "tuning tickets as incident comments until a ticketing tool is bound"
      }
    ]
  },
