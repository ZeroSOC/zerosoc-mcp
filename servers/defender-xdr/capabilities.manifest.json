        "requires_all": [
          "hunting:EmailEvents"
        ],
        "requires_any": [],
        "notes": "the Email* and UrlClickEvents hunting tables"
      }
    ],
    "telemetry.cloud": [
      {
        "tool": "mcp:defender-xdr/defender_run_hunting_query",
        "operation": "defender-xdr:run_hunting_query",
        "kind": "read",
        "permissions": [
          "ThreatHunting.Read.All"
        ],
        "requires_all": [
          "hunting:CloudAppEvents"
        ],
        "requires_any": [],
        "notes": "the CloudAppEvents hunting table"
      }
    ],
    "telemetry.network": [
      {
        "tool": "mcp:defender-xdr/defender_run_hunting_query",
        "operation": "defender-xdr:run_hunting_query",
        "kind": "read",
        "permissions": [
          "ThreatHunting.Read.All"
        ],
        "requires_all": [
          "hunting:DeviceNetworkEvents"
        ],
        "requires_any": [],
        "notes": "connections as seen by the endpoint sensor; no proxy, DNS or firewall logs"
      }
    ],
    "siem.search": [
      {
        "tool": "mcp:defender-xdr/defender_run_hunting_query",
        "operation": "defender-xdr:run_hunting_query",
        "kind": "read",
        "permissions": [
          "ThreatHunting.Read.All"
        ],
        "requires_all": [],
        "requires_any": [
          "hunting:DeviceProcessEvents",
          "hunting:IdentityLogonEvents",
          "hunting:EmailEvents",
          "hunting:CloudAppEvents"
        ],
        "notes": "cross-workload KQL over the hunting tables the tenant exposes, 30 days"
      }
    ],
    "containment.isolate_host": [
      {
        "tool": "mcp:defender-xdr/defender_isolate_machine",
        "operation": "defender-xdr:isolate_machine",
        "kind": "action",
        "permissions": [
          "Machine.Isolate"
        ],
        "requires_all": [
          "api:mde.machines",
          "role:mde/Machine.Isolate"
        ],
        "requires_any": [],
        "rollback": {
          "tool": "mcp:defender-xdr/defender_unisolate_machine",
          "operation": "defender-xdr:unisolate_machine"
        }
      }
    ],
    "containment.quarantine_file": [
      {
        "tool": "mcp:defender-xdr/defender_stop_and_quarantine_file",
        "operation": "defender-xdr:stop_and_quarantine_file",
        "kind": "action",
        "permissions": [
          "Machine.StopAndQuarantine"
        ],
        "requires_all": [
          "api:mde.machines",
          "role:mde/Machine.StopAndQuarantine"
        ],
        "requires_any": [],
        "notes": "release from quarantine is done on the device or in the portal"
      }
    ],
    "containment.block_indicator": [
      {
        "tool": "mcp:defender-xdr/defender_create_indicator",
        "operation": "defender-xdr:create_indicator",
        "kind": "action",
        "permissions": [
          "Ti.ReadWrite.All"
        ],
        "requires_all": [
          "api:mde.machines",
          "role:mde/Ti.ReadWrite.All"
        ],
        "requires_any": [],
        "notes": "enforced on onboarded devices, not at the perimeter",
        "rollback": {
          "tool": "mcp:defender-xdr/defender_delete_indicator",
          "operation": "defender-xdr:delete_indicator"
        }
      }
    ],
    "ticketing": [
      {
        "tool": "mcp:defender-xdr/defender_add_incident_comment",
