  "manual_checks": [
    {
      "id": "attack_disruption_actions",
      "description": "Automatic attack disruption (for example a contained user) is not returned by the incident, alert or machine-action APIs. Where the DisruptionAndResponseEvents hunting table holds data, query it; otherwise check the incident's Action center in the portal by hand and record what it shows. Never report containment state without it.",
      "automated_by": "hunting:DisruptionAndResponseEvents"
    }
  ],
