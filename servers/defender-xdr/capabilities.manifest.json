{
  "server": "defender-xdr",
  "version": "0.3.7",
  "packages": {
    "client": "zerosoc-defender-xdr",
    "mcp_server": "zerosoc-mcp-defender-xdr"
  },
  "alert_type_map": "alert_types.defender-xdr.json",
  "capabilities": {
    "asset.cmdb": [
      {
        "tool": "mcp:defender-xdr/defender_get_machine_by_id",
        "operation": "defender-xdr:get_machine",
        "kind": "read",
        "permissions": [
          "Machine.Read.All"
        ],
        "requires_all": [
          "api:mde.machines"
        ],
        "requires_any": [],
        "notes": "device role, OS, exposure, tags and device value (list_software for the software inventory); business criticality comes from the SOC Knowledge Base"
      }
    ],
    "identity.directory": [
      {
        "tool": "mcp:defender-xdr/defender_run_hunting_query",
        "operation": "defender-xdr:run_hunting_query",
        "kind": "read",
        "permissions": [
          "ThreatHunting.Read.All"
        ],
        "requires_all": [
          "hunting:IdentityInfo"
        ],
        "requires_any": [],
        "notes": "the IdentityInfo table: department, title, group membership, assigned roles"
      },
      {
        "tool": "mcp:defender-xdr/defender_get_user_machines",
        "operation": "defender-xdr:get_user_machines",
        "kind": "read",
        "permissions": [
          "Machine.Read.All"
        ],
        "requires_all": [
          "api:mde.machines"
        ],
        "requires_any": [],
        "notes": "logon relationships only; role and privilege need a directory tool bound here"
      }
    ],
    "cases.store": [
      {
        "tool": "mcp:defender-xdr/defender_list_incidents",
        "operation": "defender-xdr:list_incidents",
        "kind": "read",
        "permissions": [
          "SecurityIncident.Read.All"
        ],
        "requires_all": [
          "api:graph.incidents"
        ],
        "requires_any": [],
        "notes": "open and closed incidents and their entities; the 90-day retrospective sweep runs here, never through telemetry"
      }
    ],
    "malware.repository": [
      {
        "tool": "mcp:defender-xdr/defender_get_file_info",
        "operation": "defender-xdr:get_file_info",
        "kind": "read",
        "permissions": [
          "File.Read.All"
        ],
        "requires_all": [
          "api:mde.machines"
        ],
        "requires_any": [],
        "notes": "prevalence and first seen by hash (get_file_statistics for the organization); only the hash leaves the environment"
      }
    ],
    "decode": [
      {
        "tool": "mcp:defender-xdr/defender_decode_command",
        "operation": "defender-xdr:decode_command",
        "kind": "read",
        "permissions": [],
        "requires_all": [
          "always:local"
        ],
        "requires_any": [],
        "notes": "encoded PowerShell commands; timestamp_to_utc for time zones"
      }
    ],
    "telemetry.endpoint": [
      {
        "tool": "mcp:defender-xdr/defender_run_hunting_query",
        "operation": "defender-xdr:run_hunting_query",
        "kind": "read",
        "permissions": [
          "ThreatHunting.Read.All"
        ],
        "requires_all": [
          "hunting:DeviceProcessEvents"
        ],
        "requires_any": [],
        "notes": "raw endpoint telemetry through the Device* hunting tables"
      },
      {
        "tool": "mcp:defender-xdr/defender_get_incident_evidence",
        "operation": "defender-xdr:get_incident_evidence",
        "kind": "read",
        "permissions": [
          "SecurityIncident.Read.All"
        ],
        "requires_all": [
          "api:graph.alerts"
        ],
        "requires_any": [],
        "notes": "alert evidence only: there is no query language to translate playbook questions into; every question the evidence does not answer is a visibility gap"
      }
    ],
    "telemetry.identity": [
      {
        "tool": "mcp:defender-xdr/entra_list_sign_ins",
        "operation": "defender-xdr:list_sign_ins",
