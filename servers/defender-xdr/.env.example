# Microsoft Entra ID app registration (client-credential flow, Application permissions).
# The server reads the process environment: pass these through your MCP host's "env" block,
# or export them in the shell that starts the server. Never commit real values.
DEFENDER_TENANT_ID=your-tenant-id
DEFENDER_CLIENT_ID=your-client-id
DEFENDER_CLIENT_SECRET=your-client-secret

# Response actions (device isolation, quarantine, live response, indicator writes, ...)
# are DISABLED by default. Set to exactly "true" to enable them for this deployment.
# DEFENDER_MCP_ALLOW_ACTIONS=true

# What this tenant is entitled to, for the sources a licensing tier gates and no query can settle.
# Comma-separated entitlement ids; setting it states the COMPLETE set, so an entitlement left out
# is stated to be absent. Leave it unset to state nothing: the probe then reports those sources as
# "undeclared" rather than guessing, which is a visibility gap and not an absence.
# Known ids: endpoint_p2 (Microsoft Defender for Endpoint Plan 2, however it is bought).
# DEFENDER_MCP_ENTITLEMENTS=endpoint_p2
